# Dockerfile optimisé pour R2 Server (Rust + Axum)
# Multi-stage build pour réduire la taille finale

FROM rust:1.84-slim as builder

# Installer les dépendances de build
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copier d'abord les manifests Cargo pour le cache
COPY Cargo.toml Cargo.lock ./
COPY r2_core/Cargo.toml ./r2_core/
COPY r2_server/Cargo.toml ./r2_server/
COPY r2_client/Cargo.toml ./r2_client/

# Créer les crates vides pour le cache
RUN mkdir -p r2_core/src r2_server/src r2_client/src
RUN echo "fn main() {}" > r2_core/src/lib.rs
RUN echo "fn main() {}" > r2_server/src/main.rs
RUN echo "fn main() {}" > r2_client/src/lib.rs

# Build les dépendances (cache layer)
RUN cargo build --release && rm -rf r2_core/src r2_server/src r2_client/src

# Copier le vrai code source
COPY r2_core ./r2_core
COPY r2_server ./r2_server
COPY r2_client ./r2_client

# Builder le binaire de production
RUN cargo build --release --bin r2_server && \
    strip target/release/r2_server

# ============ IMAGE FINALE ============

FROM debian:bookworm-slim

# Installer le runtime minimum
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

WORKDIR /app

# Copier le binaire depuis le builder
COPY --from=builder /app/target/release/r2_server /app/r2-server

# Utiliser un utilisateur non-root
RUN useradd -m -u 1001 r2
USER r2

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

CMD ["/app/r2-server"]
